# Copy this file to `.env` and fill in your own values.

# Application
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# MongoDB connection string.
# Local install: mongodb://127.0.0.1:27017
# Atlas:         mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
#
# Do NOT commit real credentials. `.env` is gitignored for this reason.
MONGODB_URI=mongodb://127.0.0.1:27017

# Database name. Overrides the database in the connection string path.
MONGODB_DB_NAME=cesro_task_3

# Comma separated list of allowed origins, or * for any origin.
CORS_ORIGIN=*

# Log format: dev | combined | tiny
LOG_FORMAT=dev
